FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=generate-a-random-secret
JWT_SECRET_KEY=generate-a-separate-random-secret
JWT_REFRESH_SECRET_KEY=generate-a-third-random-secret
# SQLite is the local development database. PostgreSQL is optional for production.
DATABASE_URL=sqlite:///blood_supply_dev.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENCRYPTION_KEY=generate-url-safe-base64-for-32-random-bytes
DEMO_ADMIN_PASSWORD=choose-a-strong-local-demo-password
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=604800
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_REFRESH=10
